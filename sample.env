# Copy to .env and fill in. .env is in .gitignore.
GEMINI_API_KEY=your-key

# Snowflake (only needed for python src/snowflake_load.py)
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=
# Set to externalbrowser to sign in through the browser (SSO / MFA) instead of a password
SNOWFLAKE_AUTHENTICATOR=
